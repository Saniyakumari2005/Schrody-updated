run = "python3 bot.py"
modules = ["python-3.12"]

[nix]
channel = "stable-25_05"
packages = ["glibcLocales"]

[deployment]
run = ["python", "bot.py"]
deploymentTarget = "vm"
ignorePorts = true

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Bot"

[[workflows.workflow]]
name = "Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python bot.py"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5904
externalPort = 80
